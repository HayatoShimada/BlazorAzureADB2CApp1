<MudGrid Spacing="2">
    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/profile">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.List" Title="登録情報" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">登録情報</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>

    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/classeslist">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Class" Title="クラス一覧" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">クラス一覧</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>

    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/teacherslist">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.School" Title="クラス一覧" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">先生一覧</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>

    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/parentslist">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.People" Title="クラス一覧" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">親一覧</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>

    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/childrenlist">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.ChildFriendly" Title="クラス一覧" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">児童一覧</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>

    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/messagelist">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Message" Title="メッセージ" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">メッセージ</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>

    <MudItem xs="6" sm="3" Class="height:200px">
        <MudLink Href="/messagesend">
            <MudCard>
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@Icons.Material.Filled.Message" Title="メッセージの送信" />
                    </CardHeaderAvatar>

                    <CardHeaderContent>
                        <MudText Typo="Typo.body1">メッセージ送信</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
            </MudCard>
        </MudLink>
    </MudItem>
</MudGrid>
